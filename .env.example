# OPTIONAL plaintext configuration. Prefer Settings > Remember key (OS credential store).
# If needed, copy to .env in the launch directory. Never commit or share .env.
# Each key is only used for its matching provider. Leave unused keys empty.
OPENAI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# openai | kimi | deepseek | ollama. Ollama needs no key.
CONNECTIONS_PROVIDER=openai
# Blank uses the provider default (or matching saved model preference).
# openai: gpt-5.4-mini; kimi: kimi-k3.1-pro; deepseek: deepseek-flash; ollama: qwen3-vl:4b
CONNECTIONS_MODEL=
